    function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, (character) => {
            const entities = {
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;","'": "&#39;"
            };

            return entities[character
            ];
        });
    }

    function renderTags(types) {
        return types
            .map(
                (type) =>
                    `<span class="party-tag">${escapeHtml(type)
        }</span>`
            )
            .join("");
    }

    function renderStarter() {
        const starterId = starterSelect.value;
        const starter = starters[starterId
        ];

        if (!starter) {
            starterResult.innerHTML =
                '<div class="party-empty">御三家を選択してください。</div>';
            return;
        }

        starterResult.innerHTML = `
            <article class="party-card party-starter-card">
                <div class="party-card-top">
                    <div class="party-card-number">
                        #${escapeHtml(starter.number)
        }
                    </div>
                    <div>
                        <h3>${escapeHtml(starter.name)
        }</h3>
                        <div class="party-card-subtitle">
                            ${escapeHtml(starter.english)
        }
                        </div>
                    </div>
                </div>

                <div class="party-tag-list">
                    ${renderTags(starter.types)
        }
                </div>

                <p><strong>役割：</strong>${escapeHtml(starter.role)
        }</p>
                <p>${escapeHtml(starter.description)
        }</p>

                <div class="party-moves">
                    <h4>技構成の例</h4>
                    <ul>
                        ${starter.moves
                            .map((move) => `<li>${escapeHtml(move)
            }</li>`)
                            .join("")
        }
                    </ul>
                    <p class="party-card-subtitle">
                        ${escapeHtml(starter.note)
        }
                    </p>
                </div>

                <a class="party-card-link" href="pokedex.html">
                    ポケモン図鑑を見る
                </a>
            </article>
        `;
    }

    function renderCandidates() {
        const version = versionSelect.value;
        const starterId = starterSelect.value;

        const filteredCandidates = candidates.filter((pokemon) => {
            const versionMatches =
                pokemon.versions.includes("both") ||
                pokemon.versions.includes(version);

            const starterMatches = pokemon.starters.includes(starterId);

            return versionMatches && starterMatches;
        });

        if (filteredCandidates.length === 0) {
            candidateStatus.textContent =
                "この条件に合う候補はまだ登録されていません。";
            candidateList.innerHTML = "";
            return;
        }

        candidateStatus.textContent =
            `${version === "heartgold" ? "ハートゴールド": "ソウルシルバー"
        }・` +
            `${starters[starterId
            ].name
        }を選んだ場合の候補です。` +
            `全${filteredCandidates.length
        }匹を候補として表示しています。`;

        candidateList.innerHTML = filteredCandidates
            .map((pokemon) => {
                const versionLabel = pokemon.versions.includes("both")
                    ? "両バージョン": version === "heartgold"
                      ? "ハートゴールド限定候補": "ソウルシルバー限定候補";

                return `
                    <article class="party-card party-candidate-card">
                        <div class="party-card-top">
                            <div class="party-card-number">
                                #${escapeHtml(pokemon.id)
            }
                            </div>
                            <div>
                                <h3>${escapeHtml(pokemon.name)
            }</h3>
                                <div class="party-card-subtitle">
                                    ${escapeHtml(pokemon.english)
            }
                                </div>
                            </div>
                        </div>

                        <div class="party-tag-list">
                            ${renderTags(pokemon.types)
            }
                            <span class="party-tag">
                                ${escapeHtml(versionLabel)
            }
                            </span>
                        </div>

                        <p><strong>役割：</strong>${escapeHtml(pokemon.role)
            }</p>
                        <p>${escapeHtml(pokemon.reason)
            }</p>

                        <ul class="party-detail-list">
                            <li>
                                <strong>入手場所：</strong>
                                ${escapeHtml(pokemon.location)
            }
                            </li>
                            <li>
                                <strong>入手時期：</strong>
                                ${escapeHtml(pokemon.timing)
            }
                            </li>
                        </ul>

                        <div class="party-moves">
                            <h4>技構成の例</h4>
                            <ul>
                                ${pokemon.moves
                                    .map(
                                        (move) =>
                                            `<li>${escapeHtml(move)
                }</li>`
                                    )
                                    .join("")
            }
                            </ul>
                            <p class="party-card-subtitle">
                                ${escapeHtml(pokemon.moveNote)
            }
                            </p>
                        </div>

                        <a class="party-card-link" href="pokedex.html">
                            ポケモン図鑑を見る
                        </a>
                    </article>
                `;
        })
            .join("");
    }

    function updatePage() {
        renderStarter();
        renderCandidates();
    }

    versionSelect.addEventListener("change", updatePage);
    starterSelect.addEventListener("change", updatePage);

    updatePage();
